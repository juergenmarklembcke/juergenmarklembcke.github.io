---
layout: archive
title: "Topics"
permalink: /tags/:name/
author_profile: true
---

{% assign tag = page.name | default: page.url | remove_first: "/tags/" | remove: "/" %}

<h2 id="{{ tag | slugify }}" class="archive__subtitle">{{ tag | capitalize | replace: '-', ' ' }}</h2>
{% include base_path %}

<h3>Publications</h3>
{% assign tagged_pubs = site.publications | where_exp: "pub", "pub.tags contains tag" %}
{% for pub in tagged_pubs %}
- [{{ pub.title }}]({{ pub.url }})
{% endfor %}

<h3>Talks</h3>
{% assign tagged_talks = site.talks | where_exp: "talk", "talk.tags contains tag" %}
{% for talk in tagged_talks %}
- [{{ talk.title }}]({{ talk.url }})
{% endfor %}
